TWOGIS_API_KEY=
TWOGIS_MAP_KEY=
PORT=4174
# Local binding; Render sets HOST=0.0.0.0.
HOST=127.0.0.1
PLANNING_TIMEOUT_MS=120000

# Minimum interval between routing requests (ms), to avoid bursts.
ROUTING_INTERVAL_MS=300

# Screenshot extraction (server only). auto prefers OpenRouter, then Groq, then Gemini.
SCREENSHOT_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Set SCREENSHOT_PROVIDER=gemini to switch back manually.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
